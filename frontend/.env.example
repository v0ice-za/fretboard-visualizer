# Copy this file to .env.local and fill in values for local development
# Never commit .env files with actual values

# Backend API URL. Leave EMPTY in local dev — the Vite dev proxy (vite.config.ts) forwards
# /api to http://localhost:8080 same-origin, so the SameSite=Lax refresh cookie works over http.
# In prod (Story 3.7) set this to the Railway backend URL for the cross-origin call.
VITE_API_URL=

# Google OAuth 2.0 Web client ID (Google Cloud Console → Credentials).
# Required for the Google sign-in button. Set the same value as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
